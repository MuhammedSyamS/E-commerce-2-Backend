# Production Environment Variables for HighPhaus Server
# Rename this file to .env in your production environment (e.g., Render)

# --- SERVER CONFIG ---
NODE_ENV=production
PORT=10000

# --- DATABASE ---
# Get this from MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/highphaus?retryWrites=true&w=majority

# --- SECURITY ---
# Access Token Secret (Long Random String)
JWT_SECRET=your_production_jwt_secret_here_make_it_long_and_secure
# Refresh Token Secret (Optional if used)
JWT_REFRESH_SECRET=your_production_refresh_secret

# --- CLIENT URL (CORS) ---
# The URL of your deployed frontend (e.g., Vercel)
CLIENT_URL=https://highphaus-client.vercel.app

# --- PAYMENTS (RAZORPAY) ---
# Get these from Razorpay Dashboard -> Settings -> API Keys (Production Mode)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- EMAIL SERVICE (NODEMAILER) ---
# Use Gmail App Password or SendGrid/Resend API Key
EMAIL_SERVICE=gmail
EMAIL_USER=your_support_email@gmail.com
EMAIL_PASS=your_app_password_here

# --- ADMIN EMAIL ---
# Email to receive critical alerts (optional)
ADMIN_EMAIL=admin@highphaus.com
