# SLOOK Production Environment Settings (Render)
# -------------------------------------------------------------------
# SECURITY POLICY:
# 1. Never commit the actual .env file to GitHub.
# 2. Use Render's Dashboard (Environment Tab) to set these values.
# 3. Rotate secrets (JWT, EMAIL_PASS) every 90 days.
# -------------------------------------------------------------------

# --- SERVER CONFIG ---
NODE_ENV=production
# PORT is automatically set by Render - do not hardcode unless required.

# --- DATABASE (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://<PROD_USER>:<PROD_PASS>@cluster0.mongodb.net/highphaus?retryWrites=true&w=majority

# --- SECURITY ---
# Generate a 64-character random string for production
JWT_SECRET=your_long_secure_production_secret_here
# Optional: Use a different secret for refresh tokens
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# --- CLIENT URL (CORS) ---
# Your deployed frontend URL (e.g., Vercel or Custom Domain)
CLIENT_URL=https://slook.luxury

# --- EMAIL SERVICE (Gmail SMTP / SendGrid) ---
# Use a Dedicated Transactional Email Account
EMAIL_USER=verify.slook@gmail.com
# Use an App Password (for Gmail) or API Key (for SendGrid)
EMAIL_PASS=your_secure_app_password_here

# Support & Press Notification Targets
SUPPORT_EMAIL=help.slook@gmail.com
SUPPORT_EMAIL_PASS=your_support_app_pass
PRESS_EMAIL=press.slook@gmail.com
PRESS_EMAIL_PASS=your_press_app_pass

# --- PAYMENTS (Razorpay Production) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- PUSH NOTIFICATIONS (VAPID) ---
# Generate new keys using 'npx web-push generate-vapid-keys'
VAPID_PUBLIC_KEY=your_production_public_key
VAPID_PRIVATE_KEY=your_production_private_key

# --- AUTH (Google OAuth) ---
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
